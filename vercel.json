{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "cleanUrls": true,
  "functions": {
    "api/og.js": {
      "includeFiles": "{public/worker.js,node_modules/katex/dist/fonts/KaTeX_SansSerif-*.ttf}",
      "maxDuration": 30
    }
  },
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": [
      "/"
    ]
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(gallery|thumbnails)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
